# Copy to .env (never commit .env). All variables are optional.

# Listen address/port. Render and most PaaS set PORT for you.
PORT=8080
HOST=0.0.0.0

# Exact origins allowed to open the WebSocket. Empty = same origin as the Host header.
# ALLOWED_ORIGINS=https://drop.example.com

# How to find the real client IP behind a proxy (used to group devices by network).
# Only set these if a trusted proxy sets the header; otherwise clients could spoof it.
# CLIENT_IP_HEADER=cf-connecting-ip
# TRUST_PROXY_HOPS=1

# STUN servers (comma-separated). Set to an empty value to disable.
# STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302

# Optional TURN relay for strict NATs, option A: coturn with use-auth-secret.
# TURN_URLS=turns:turn.example.com:5349,turn:turn.example.com:3478
# TURN_SECRET=change-me
# TURN_TTL_SECONDS=14400

# Optional TURN relay, option B: Cloudflare Realtime TURN (1,000 GB/month free).
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=

# Limits
# MAX_CONNECTIONS=20000
# MAX_CONNECTIONS_PER_IP=64
# MAX_ROOM_SIZE=100

# debug | info | warn | error | silent
LOG_LEVEL=info
